# ==============================================================================
# AI Talent Screener & Technical Interviewer — Environment Configuration
# Copy this file to `.env` before running locally (`cp .env.example .env`).
# Leaving API keys blank automatically activates Zero-Key Deterministic Mode.
# ==============================================================================

# --- LLM Provider Bridge (deterministic | groq | openai | gemini | custom) ---
LLM_PROVIDER=deterministic
LLM_TIMEOUT_SECONDS=20.0

# Groq Cloud (default model when GROQ_API_KEY is set: llama-3.3-70b-versatile)
GROQ_API_KEY=

# OpenAI (default model when OPENAI_API_KEY is set: gpt-4o-mini)
OPENAI_API_KEY=

# Google Gemini OpenAI-Compatible Endpoint (default: gemini-2.0-flash)
GEMINI_API_KEY=

# Custom OpenAI-Compatible Endpoint (e.g. vLLM / LiteLLM / OpenRouter / Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Backend Persistence & Security ---
# Use ":memory:" for ephemeral local showcase, or e.g. "./runtime_demo.db" for persistence
DB_DSN=:memory:
# Minimum 16 UTF-8 bytes when fixed across restarts (blank = secure ephemeral CSPRNG key)
JWT_SECRET=
WS_NODE_ID=ws-node-1
API_HOST=127.0.0.1
API_PORT=8000

# --- Interactive Showcase Demo Seeder ---
DEMO_SEED_ENABLED=true

# --- Next.js Frontend Runtime ---
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000
